<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Plastr{% if version %} {{ version }}{% endif %}">
<title>{{ title }}</title>
<style>
:root {
  --ink: #1b1f23;
  --muted: #6a737d;
  --rule: #e3e6ea;
  --rule-strong: #ccd2d9;
  --paper: #ffffff;
  --panel: #f7f8fa;
  --accent: #2563a8;
  --accent-soft: #eef4fb;
  --good: #2f7d4f;
  --warn: #b06b00;
  --bad: #bf2626;
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  margin: 0;
  background: #eef0f3;
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue",
               Helvetica, Arial, "Noto Sans", sans-serif;
  font-size: 14px;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}
.page {
  max-width: 1080px;
  margin: 0 auto;
  background: var(--paper);
  padding: 34px 40px 56px;
  box-shadow: 0 1px 3px rgba(0,0,0,.12);
}

/* ---------- header ---------- */
header.doc { border-bottom: 2px solid var(--ink); padding-bottom: 16px; margin-bottom: 24px; }
header.doc h1 { font-size: 25px; font-weight: 600; margin: 0 0 4px; letter-spacing: -.2px; }
header.doc .kicker {
  font-size: 11px; text-transform: uppercase; letter-spacing: .13em;
  color: var(--accent); font-weight: 600; margin-bottom: 6px;
}
.meta {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 4px 28px; margin-top: 12px; font-size: 12.5px; color: var(--muted);
}
.meta div { overflow-wrap: anywhere; }
.meta b { color: var(--ink); font-weight: 600; }
code, .mono {
  font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas,
               "Liberation Mono", monospace;
  font-size: .93em;
}

/* ---------- tabs ---------- */
nav.tabs {
  display: flex; flex-wrap: wrap; gap: 2px;
  border-bottom: 1px solid var(--rule-strong); margin-bottom: 26px;
}
nav.tabs button {
  appearance: none; border: 1px solid transparent; border-bottom: none;
  background: none; font: inherit; font-size: 13px; font-weight: 500;
  color: var(--muted); padding: 8px 15px; cursor: pointer;
  border-radius: 5px 5px 0 0; margin-bottom: -1px;
}
nav.tabs button:hover { color: var(--ink); background: var(--panel); }
nav.tabs button[aria-selected="true"] {
  color: var(--accent); background: var(--paper);
  border-color: var(--rule-strong); border-bottom: 1px solid var(--paper);
  font-weight: 600;
}
.panel[hidden] { display: none; }
.panel > h2:first-child { margin-top: 0; }

/* ---------- headings ---------- */
h2 {
  font-size: 16px; font-weight: 600; margin: 34px 0 12px;
  padding-bottom: 6px; border-bottom: 1px solid var(--rule);
}
h3 { font-size: 13.5px; font-weight: 600; margin: 22px 0 8px; }
p.lead { color: var(--muted); margin: -4px 0 16px; font-size: 13px; max-width: 70ch; }

/* ---------- stat cards ---------- */
.cards {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(168px, 1fr));
  gap: 12px; margin: 18px 0 8px;
}
.card {
  border: 1px solid var(--rule); border-radius: 6px; padding: 12px 14px;
  background: var(--panel); border-top: 3px solid var(--accent);
}
.card .label {
  font-size: 10.5px; text-transform: uppercase; letter-spacing: .09em;
  color: var(--muted); font-weight: 600;
}
.card .value { font-size: 22px; font-weight: 600; margin: 3px 0 1px; letter-spacing: -.4px; }
.card .note { font-size: 11.5px; color: var(--muted); }
.card.good { border-top-color: var(--good); }
.card.good .value { color: var(--good); }
.card.warn { border-top-color: var(--warn); }
.card.warn .value { color: var(--warn); }
.card.bad  { border-top-color: var(--bad); }
.card.bad  .value { color: var(--bad); }

/* ---------- tables ---------- */
table { border-collapse: collapse; width: 100%; margin: 10px 0 18px; font-size: 13px; }
caption {
  caption-side: top; text-align: left; font-size: 12px; color: var(--muted);
  padding-bottom: 6px;
}
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--rule); vertical-align: top; }
thead th {
  font-size: 11px; text-transform: uppercase; letter-spacing: .07em;
  color: var(--muted); font-weight: 600; border-bottom: 1.5px solid var(--rule-strong);
  white-space: nowrap;
}
tbody tr:hover { background: var(--accent-soft); }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.stats td:first-child { width: 44%; }
table.stats td.v { font-weight: 600; text-align: right; white-space: nowrap; }
table.stats .hint { display: block; font-weight: 400; font-size: 11.5px; color: var(--muted); }
table.compare th:not(:first-child), table.compare td:not(:first-child) { text-align: right; }
table.compare thead th:not(:first-child) { color: var(--accent); }
table.compare tbody td:not(:first-child) { font-weight: 600; }

table.sortable thead th { cursor: pointer; user-select: none; position: relative; padding-right: 18px; }
table.sortable thead th::after {
  content: "\2195"; position: absolute; right: 5px; opacity: .28; font-size: 10px;
}
table.sortable thead th[data-dir="asc"]::after  { content: "\2191"; opacity: .9; }
table.sortable thead th[data-dir="desc"]::after { content: "\2193"; opacity: .9; }

.scroll { overflow-x: auto; }

/* ---------- badges & chips ---------- */
.badge {
  display: inline-block; padding: 1px 7px; border-radius: 9px; font-size: 11px;
  font-weight: 600; color: #fff; white-space: nowrap;
}
.tag {
  display: inline-block; padding: 0 6px; border-radius: 3px; font-size: 11px;
  background: var(--panel); border: 1px solid var(--rule); color: var(--muted);
}
.orient {
  display: inline-block; width: 17px; text-align: center; border-radius: 3px;
  font-weight: 700; background: var(--panel); border: 1px solid var(--rule);
}
.chips { display: flex; flex-wrap: wrap; gap: 5px; margin: 6px 0 16px; }
.chips code {
  background: var(--panel); border: 1px solid var(--rule); border-radius: 3px;
  padding: 1px 6px; font-size: 11.5px;
}

/* ---------- charts ---------- */
.figure { margin: 16px 0 26px; break-inside: avoid; }
.figure figcaption { font-size: 12px; color: var(--muted); margin-top: 4px; }
.figure .cap-title { font-weight: 600; color: var(--ink); }
.grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 8px 26px; }
svg.chart { display: block; width: 100%; height: auto; overflow: visible; }
svg.chart .grid { stroke: var(--rule); stroke-width: 1; }
svg.chart .axis { stroke: #aab1b8; stroke-width: 1; }
svg.chart .tick { fill: var(--muted); font-size: 11px; font-family: inherit; }
svg.chart .axlabel { fill: var(--muted); font-size: 11.5px; font-family: inherit; }
svg.chart .note { fill: var(--ink); font-size: 11.5px; font-weight: 600; font-family: inherit; }
svg.chart .series { fill: none; stroke: #2563a8; stroke-width: 1.9; stroke-linejoin: round; }
svg.chart .area { fill: #cbdcf0; opacity: .55; stroke: none; }
svg.chart .bar { fill: #5b8fc9; }
svg.chart .marker { fill: #2563a8; }
svg.chart .guide { stroke: #bf2626; stroke-width: 1; stroke-dasharray: 4 3; }
svg.chart .idtrack { fill: #edeff2; stroke: #d5dae0; stroke-width: .8; }
svg.chart .idcov { fill: #3d8f5a; }
svg.chart .idlabel { fill: var(--ink); font-size: 12px; font-weight: 600; font-family: inherit; }
svg.chart .idpct { fill: var(--muted); font-size: 11.5px; font-family: inherit; }
svg.chart .idsize { fill: var(--muted); font-size: 10px; font-family: inherit; }

/* ---------- misc ---------- */
.callout {
  border-left: 3px solid var(--warn); background: #fdf7ec; padding: 9px 13px;
  margin: 12px 0; font-size: 12.5px; border-radius: 0 4px 4px 0;
}
.callout.info { border-left-color: var(--accent); background: var(--accent-soft); }
.callout ul { margin: 4px 0 0; padding-left: 18px; }
.empty-note { color: var(--muted); font-style: italic; font-size: 13px; }
footer.doc {
  margin-top: 44px; padding-top: 12px; border-top: 1px solid var(--rule);
  font-size: 11.5px; color: var(--muted); display: flex;
  justify-content: space-between; gap: 16px; flex-wrap: wrap;
}
.scaffold-block { margin: 0 0 26px; break-inside: avoid; }
.scaffold-block h3 { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
.scaffold-block h3 .sub { font-weight: 400; font-size: 12px; color: var(--muted); }

/* ---------- print ---------- */
@media print {
  body { background: #fff; font-size: 10pt; }
  .page { max-width: none; box-shadow: none; padding: 0; }
  nav.tabs { display: none; }
  .panel[hidden] { display: block !important; }
  .panel { break-before: page; }
  .panel:first-of-type { break-before: auto; }
  tbody tr:hover { background: none; }
  table.sortable thead th::after { content: ""; }
  h2 { break-after: avoid; }
  tr, .card, .figure, .scaffold-block { break-inside: avoid; }
  thead { display: table-header-group; }
  a { text-decoration: none; color: inherit; }
  /* Predictable two-column layouts at paper width. */
  .meta { grid-template-columns: 1fr 1fr; gap: 3px 22px; }
  .grid2 { grid-template-columns: 1fr 1fr; gap: 6px 16px; }
  .cards { grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .figure { margin: 10px 0 16px; }
  /* The SVGs shrink to fit the page, so scale their type up to compensate. */
  svg.chart .tick    { font-size: 15px; }
  svg.chart .axlabel { font-size: 16px; }
  svg.chart .note    { font-size: 15px; }
  svg.chart .idlabel { font-size: 15px; }
  svg.chart .idpct   { font-size: 14px; }
  svg.chart .idsize  { font-size: 12px; }
  .card, .idtrack, svg.chart .idcov, .badge {
    -webkit-print-color-adjust: exact; print-color-adjust: exact;
  }
}
@page { margin: 14mm; }
</style>
</head>
<body>
<div class="page">

<header class="doc">
  <div class="kicker">Assembly quality control</div>
  <h1>{{ title }}</h1>
  <div class="meta">
    <div><b>Generated</b> {{ generated }}</div>
    {% if source_path %}<div><b>Assembly</b> <span class="mono">{{ source_path }}</span></div>{% endif %}
    {% if reference_path %}<div><b>Reference</b> <span class="mono">{{ reference_path }}</span></div>{% endif %}
    <div><b>Contigs</b> {{ metrics.num_contigs | fmt_int }} &middot;
         <b>Total</b> {{ metrics.total_length | fmt_bp }} &middot;
         <b>N50</b> {{ metrics.n50 | fmt_bp }}</div>
  </div>
</header>

{% set tabs = [('summary', 'Summary'), ('basic', 'Basic statistics')] %}
{% if reference %}{% set tabs = tabs + [('reference', 'Reference-based'), ('misassemblies', 'Misassemblies')] %}{% endif %}
{% if scaffold %}{% set tabs = tabs + [('scaffolding', 'Scaffolding')] %}{% endif %}
{% if comparison %}{% set tabs = tabs + [('comparison', 'Comparison')] %}{% endif %}

<nav class="tabs" role="tablist">
  {% for key, label in tabs %}
  <button role="tab" id="tab-{{ key }}" aria-controls="panel-{{ key }}"
          aria-selected="{{ 'true' if loop.first else 'false' }}"
          data-target="panel-{{ key }}">{{ label }}</button>
  {% endfor %}
</nav>

{% if comparison and subject %}
<div class="callout info" id="subject-note">
  Every tab except <strong>Comparison</strong> describes
  <code>{{ subject }}</code> alone. Open the Comparison tab to see all
  assemblies side by side.
</div>
{% endif %}

<!-- ==================== SUMMARY ==================== -->
<section class="panel" id="panel-summary" role="tabpanel" aria-labelledby="tab-summary">
  <h2>Summary</h2>
  <div class="cards">
    {% for card in cards %}
    <div class="card {{ card.tone }}">
      <div class="label">{{ card.label }}</div>
      <div class="value">{{ card.value }}</div>
      <div class="note">{{ card.note }}</div>
    </div>
    {% endfor %}
  </div>

  <div class="grid2">
    <figure class="figure">
      {{ charts.cumulative | safe }}
      <figcaption><span class="cap-title">Cumulative length.</span>
        Contigs sorted longest first; the curve reaches the assembly total.</figcaption>
    </figure>
    <figure class="figure">
      {{ charts.nx | safe }}
      <figcaption><span class="cap-title">Nx curve.</span>
        At x&nbsp;=&nbsp;50 the value is N50. A flatter curve means more even contig lengths.</figcaption>
    </figure>
  </div>

  <figure class="figure">
    {{ charts.histogram | safe }}
    <figcaption><span class="cap-title">Contig length distribution.</span>
      Log-spaced bins; hover a bar for its range and count.</figcaption>
  </figure>

  {% if reference %}
  <h2>Reference coverage</h2>
  <p class="lead">Each reference sequence is drawn to scale relative to the longest.
     Green blocks are covered by at least one alignment; the flags above the bar mark
     misassembly breakpoints.</p>
  <figure class="figure">
    {{ charts.ideogram | safe }}
    <figcaption><span class="cap-title">Ideogram.</span>
      Genome fraction {{ reference.genome_fraction | fmt_pct }} over
      {{ reference.reference_sequences | fmt_int }} reference sequence(s).</figcaption>
  </figure>
  {% endif %}

  {% if scaffold and charts.scaffold_n50 %}
  <h2>Contiguity after scaffolding</h2>
  <div class="grid2">
    <figure class="figure">
      {{ charts.scaffold_n50 | safe }}
      <figcaption><span class="cap-title">N50 before and after scaffolding.</span>
        {{ scaffold.scaffolds | length | fmt_int }} scaffold(s) built from
        {{ metrics.num_contigs | fmt_int }} contigs.</figcaption>
    </figure>
  </div>
  {% endif %}
</section>

<!-- ==================== BASIC ==================== -->
<section class="panel" id="panel-basic" role="tabpanel" aria-labelledby="tab-basic" hidden>
  <h2>Basic statistics</h2>
  <p class="lead">Reference-free statistics computed over the segments of the assembly graph.
     Values that could not be determined are shown as {{ dash }}.</p>
  <table class="stats">
    <caption>Reference-free assembly statistics</caption>
    <tbody>
      {% for row in basic_rows %}
      <tr>
        <td>{{ row.label }}{% if row.hint %}<span class="hint">{{ row.hint }}</span>{% endif %}</td>
        <td class="v">{{ row.value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</section>

<!-- ==================== REFERENCE ==================== -->
{% if reference %}
<section class="panel" id="panel-reference" role="tabpanel" aria-labelledby="tab-reference" hidden>
  <h2>Reference-based statistics</h2>
  <p class="lead">Derived from contig-to-reference alignments, following the QUAST definitions.</p>
  <table class="stats">
    <caption>Reference-based assembly statistics</caption>
    <tbody>
      {% for row in reference_rows %}
      <tr>
        <td>{{ row.label }}{% if row.hint %}<span class="hint">{{ row.hint }}</span>{% endif %}</td>
        <td class="v">{{ row.value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if per_reference %}
  <h3>Coverage per reference sequence</h3>
  <table class="sortable">
    <thead><tr><th>Reference sequence</th><th class="num">Covered</th><th class="num">Blocks</th></tr></thead>
    <tbody>
      {% for name, pct in per_reference %}
      <tr>
        <td class="mono">{{ name }}</td>
        <td class="num" data-sort="{{ pct }}">{{ pct | fmt_pct }}</td>
        <td class="num">{{ (reference.coverage_blocks.get(name) or []) | length | fmt_int }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% endif %}

  {% if misassembled_contigs %}
  <h3>Misassembled contigs</h3>
  <div class="chips">
    {% for name in misassembled_contigs %}<code>{{ name }}</code>{% endfor %}
  </div>
  {% endif %}
</section>

<!-- ==================== MISASSEMBLIES ==================== -->
<section class="panel" id="panel-misassemblies" role="tabpanel" aria-labelledby="tab-misassemblies" hidden>
  <h2>Misassemblies</h2>
  <p class="lead">
    {{ reference.num_misassemblies | fmt_int }} extensive misassembly event(s) and
    {{ reference.num_local_misassemblies | fmt_int }} local event(s).
    Click a column header to sort.
  </p>
  {% if misassemblies %}
  <div class="scroll">
  <table class="sortable">
    <caption>Breakpoints where adjacent alignment blocks of one contig disagree with the reference</caption>
    <thead>
      <tr>
        <th>Contig</th>
        <th>Type</th>
        <th class="num">Position in contig</th>
        <th>Reference location</th>
        <th class="num">Reference gap</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {% for event in misassemblies %}
      <tr>
        <td class="mono">{{ event.contig }}</td>
        <td>
          <span class="badge" style="background:{{ event.colour }}">{{ event.kind }}</span>
          {% if not event.extensive %}<span class="tag">local</span>{% endif %}
        </td>
        <td class="num" data-sort="{{ event.contig_pos if event.contig_pos is not none else 0 }}">{{ event.contig_pos_text }}</td>
        <td class="mono">{{ event.location }}</td>
        <td class="num">{{ event.ref_gap }}</td>
        <td>{{ event.description }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
  {% else %}
  <p class="empty-note">No misassemblies were detected.</p>
  {% endif %}
</section>
{% endif %}

<!-- ==================== SCAFFOLDING ==================== -->
{% if scaffold %}
<section class="panel" id="panel-scaffolding" role="tabpanel" aria-labelledby="tab-scaffolding" hidden>
  <h2>Scaffolding summary</h2>
  <table class="stats">
    <caption>Scaffold plan and the sequence built from it</caption>
    <tbody>
      {% for row in scaffold.summary %}
      <tr>
        <td>{{ row.label }}{% if row.hint %}<span class="hint">{{ row.hint }}</span>{% endif %}</td>
        <td class="v">{{ row.value }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if scaffold.notes %}
  <div class="callout info"><b>Plan notes</b>
    <ul>{% for note in scaffold.notes %}<li>{{ note }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  {% if scaffold.warnings %}
  <div class="callout"><b>Build warnings</b>
    <ul>{% for warning in scaffold.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
  </div>
  {% endif %}

  <h2>Scaffolds</h2>
  {% if scaffold.scaffolds %}
    {% for s in scaffold.scaffolds %}
    <div class="scaffold-block">
      <h3><span class="mono">{{ s.name }}</span>
        <span class="sub">{{ s.member_count | fmt_int }} member(s) &middot; {{ s.length }}
          &middot; source {{ s.source }}{% if s.reference != dash %} &middot; reference {{ s.reference }}{% endif %}</span>
      </h3>
      <div class="scroll">
      <table class="sortable">
        <thead>
          <tr>
            <th class="num">#</th>
            <th>Contig</th>
            <th>Orient.</th>
            <th>Reference span</th>
            <th class="num">Identity</th>
            <th class="num">Gap after</th>
            <th>Gap evidence</th>
            <th>Graph bridge</th>
          </tr>
        </thead>
        <tbody>
          {% for m in s.members %}
          <tr>
            <td class="num">{{ loop.index }}</td>
            <td class="mono">{{ m.segment }}{% if m.overlaps_previous %} <span class="tag">overlaps previous</span>{% endif %}</td>
            <td><span class="orient">{{ m.orientation }}</span></td>
            <td class="mono">{{ m.ref_span }}</td>
            <td class="num">{{ m.identity }}</td>
            <td class="num">{{ m.gap_after }}</td>
            <td>{% if m.gap_evidence != dash %}<span class="tag">{{ m.gap_evidence }}</span>{% else %}{{ dash }}{% endif %}</td>
            <td class="mono">{{ m.bridge }}{% if m.bridge != dash %} <span class="tag">{{ m.bridge_length }} bp</span>{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>
    </div>
    {% endfor %}
  {% else %}
  <p class="empty-note">The plan contains no scaffolds.</p>
  {% endif %}

  {% if scaffold.unplaced %}
  <h3>Unplaced contigs ({{ scaffold.unplaced | length | fmt_int }})</h3>
  <div class="chips">{% for name in scaffold.unplaced %}<code>{{ name }}</code>{% endfor %}</div>
  {% endif %}
  {% if scaffold.redundant %}
  <h3>Redundant contigs ({{ scaffold.redundant | length | fmt_int }})</h3>
  <p class="lead">Excluded because another contig claimed the same reference span.</p>
  <div class="chips">{% for name in scaffold.redundant %}<code>{{ name }}</code>{% endfor %}</div>
  {% endif %}
</section>
{% endif %}

<!-- ==================== COMPARISON ==================== -->
{% if comparison %}
<section class="panel" id="panel-comparison" role="tabpanel" aria-labelledby="tab-comparison" hidden>
  <h2>Comparison</h2>
  <p class="lead">{{ comparison.columns | length }} assemblies side by side.</p>
  <div class="scroll">
  <table class="compare sortable">
    <caption>Side-by-side statistics</caption>
    <thead>
      <tr>
        <th>Statistic</th>
        {% for name in comparison.columns %}<th class="num">{{ name }}</th>{% endfor %}
      </tr>
    </thead>
    <tbody>
      {% for row in comparison.rows %}
      <tr>
        <td>{{ row.label }}</td>
        {% for value in row['values'] %}<td class="num">{{ value }}</td>{% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>
</section>
{% endif %}

<footer class="doc">
  <span>Generated by Plastr{% if version %} {{ version }}{% endif %} &middot; {{ generated_utc }}</span>
  <span>Self-contained report &middot; no external resources</span>
</footer>

</div>

<script>
(function () {
  "use strict";

  /* ---- tabs ---- */
  var buttons = Array.prototype.slice.call(document.querySelectorAll("nav.tabs button"));
  function show(id) {
    buttons.forEach(function (b) {
      var on = b.dataset.target === id;
      b.setAttribute("aria-selected", on ? "true" : "false");
      var panel = document.getElementById(b.dataset.target);
      if (panel) { panel.hidden = !on; }
    });
    if (window.history && window.history.replaceState) {
      window.history.replaceState(null, "", "#" + id.replace(/^panel-/, ""));
    }
  }
  buttons.forEach(function (b) {
    b.addEventListener("click", function () { show(b.dataset.target); });
  });
  if (window.location.hash) {
    var wanted = "panel-" + window.location.hash.slice(1);
    if (document.getElementById(wanted)) { show(wanted); }
  }
  /* Reveal every panel for printing, then restore. */
  function unhide() { document.querySelectorAll(".panel").forEach(function (p) { p.hidden = false; }); }
  function restore() {
    var active = document.querySelector('nav.tabs button[aria-selected="true"]');
    if (active) { show(active.dataset.target); }
  }
  window.addEventListener("beforeprint", unhide);
  window.addEventListener("afterprint", restore);

  /* ---- sortable tables ---- */
  function cellValue(row, index) {
    var cell = row.cells[index];
    if (!cell) { return ""; }
    return cell.dataset.sort !== undefined ? cell.dataset.sort : cell.textContent.trim();
  }
  function asNumber(text) {
    var cleaned = String(text).replace(/[,\s]/g, "").replace(/%$/, "");
    if (!/^-?\d*\.?\d+([eE][-+]?\d+)?$/.test(cleaned)) { return null; }
    return parseFloat(cleaned);
  }
  document.querySelectorAll("table.sortable").forEach(function (table) {
    var head = table.tHead;
    var body = table.tBodies[0];
    if (!head || !body) { return; }
    Array.prototype.slice.call(head.rows[0].cells).forEach(function (th, index) {
      th.addEventListener("click", function () {
        var dir = th.dataset.dir === "asc" ? "desc" : "asc";
        Array.prototype.slice.call(head.rows[0].cells).forEach(function (o) {
          delete o.dataset.dir;
        });
        th.dataset.dir = dir;
        var sign = dir === "asc" ? 1 : -1;
        var rows = Array.prototype.slice.call(body.rows);
        rows.sort(function (a, b) {
          var av = cellValue(a, index), bv = cellValue(b, index);
          var an = asNumber(av), bn = asNumber(bv);
          if (an !== null && bn !== null) { return sign * (an - bn); }
          return sign * String(av).localeCompare(String(bv), undefined, { numeric: true });
        });
        rows.forEach(function (r) { body.appendChild(r); });
      });
    });
  });
})();
</script>
</body>
</html>
